@model List<LibraryManagementSystem.Models.Student>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Student Management</h3>
        <p class="text-muted mb-0">View and manage registered students</p>
    </div>

    <a asp-action="Create" class="btn btn-primary add-student-btn">
        <span class="me-1">+</span> Add Student
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="student-table-wrapper">
    <div class="student-table-header">
        <div>
            <h5 class="mb-1 text-white">Student Records</h5>
            <small>All registered students</small>
        </div>

        <span class="student-count">
            @(Model?.Count ?? 0) Students
        </span>
    </div>

    <div class="table-responsive">
        <table class="table student-table mb-0">
            <thead>
                <tr>
                    <th>STUDENT ID</th>
                    <th>STUDENT NAME</th>
                    <th>PHONE NUMBER</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="student-id">#@item.StudentId</span>
                            </td>

                            <td>
                                <span class="student-name">@item.StudentName</span>
                            </td>

                            <td>@item.PhoneNumber</td>

                            <td class="text-end text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@item.StudentId"
                                   class="student-action edit-action">
                                    Edit
                                </a>

                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.StudentId" />

                                    <button type="submit"
                                            class="student-action delete-action"
                                            onclick="return confirm('Are you sure you want to delete this student?')">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            No student records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
