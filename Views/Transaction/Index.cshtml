@model List<LibraryManagementSystem.Models.BookTransaction>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Transactions</h3>
        <p class="text-muted mb-0 small">All book issue and return records</p>
    </div>

    <a asp-controller="Transaction"
       asp-action="Create"
       class="btn btn-primary px-3">
        + New Transaction
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive transaction-table">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>REFERENCE NUMBER</th>
                <th>REFERENCE DATE</th>
                <th>STUDENT NAME</th>
                <th>BOOK TYPE</th>
                <th>BOOK NAME</th>
                <th>BORROW / RETURN</th>
                <th>QUANTITY</th>
                <th class="text-end">ACTIONS</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="reference-number">
                            @item.ReferenceNo
                        </td>

                        <td class="text-muted">
                            @item.ReferenceDate.ToString("dd MMM yyyy")
                        </td>

                        <td class="student-name">
                            @item.StudentName
                        </td>

                        <td>
                            @item.BookTypeName
                        </td>

                        <td>
                            @item.BookName
                        </td>

                        <td>
                            @if (item.TransactionType == "Borrow")
                            {
                                <span class="badge bg-primary">Borrow</span>
                            }
                            else if (item.TransactionType == "Return")
                            {
                                <span class="badge bg-success">Return</span>
                            }
                        </td>

                        <td>
                            <span class="quantity-label">
                                @item.Quantity
                            </span>
                        </td>

                        <td class="text-end text-nowrap">
                            <a asp-action="Details"
                               asp-route-id="@item.TransactionId"
                               class="action-link view-link">View</a>

                            <a asp-action="Edit"
                               asp-route-id="@item.TransactionId"
                               class="action-link edit-link">Edit</a>

                            <form asp-action="Delete"
                                  asp-route-id="@item.TransactionId"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="action-link delete-link"
                                        onclick="return confirm('Are you sure you want to delete this transaction?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="empty-table">
                        No transactions found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
