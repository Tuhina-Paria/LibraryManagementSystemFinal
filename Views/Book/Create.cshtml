@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Add Book";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4>Add New Book</h4>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="BookName" class="form-label">Book Name</label>
                    <input asp-for="BookName" class="form-control" />
                    <span asp-validation-for="BookName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BookTypeId" class="form-label">Book Type</label>
                    <select asp-for="BookTypeId"
                            asp-items="ViewBag.BookTypes"
                            class="form-select">
                        <option value="">-- Select Book Type --</option>
                    </select>
                    <span asp-validation-for="BookTypeId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalQuantity" class="form-label">Total Quantity</label>
                    <input asp-for="TotalQuantity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="TotalQuantity" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save Book</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}