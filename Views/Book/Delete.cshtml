@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4>Delete Book</h4>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this book?
            </div>

            <dl class="row">
                <dt class="col-sm-4">Book Name</dt>
                <dd class="col-sm-8">@Model.BookName</dd>

                <dt class="col-sm-4">Book Type</dt>
                <dd class="col-sm-8">@Model.BookTypeName</dd>

                <dt class="col-sm-4">Total Quantity</dt>
                <dd class="col-sm-8">@Model.TotalQuantity</dd>

                <dt class="col-sm-4">Available Quantity</dt>
                <dd class="col-sm-8">@Model.AvailableQuantity</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
